# ---------------------------------------------------------------------------
# Homiva environment configuration
# Copy this file to `.env` and fill in the values.
# ---------------------------------------------------------------------------

# --- Client (Vite) - safe to expose to the browser ---
VITE_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=6a56af86002ae69ae1fc

# These IDs are stable slugs created by `npm run setup:appwrite`
VITE_APPWRITE_DATABASE_ID=homiva
VITE_APPWRITE_BUCKET_PROPERTY_IMAGES=property-images
VITE_APPWRITE_BUCKET_AVATARS=avatars
VITE_APPWRITE_BUCKET_VERIFICATION_DOCUMENTS=verification-documents
VITE_APPWRITE_FUNCTION_ADMIN=homiva-admin
VITE_APPWRITE_FUNCTION_PAYMENTS=homiva-payments
VITE_APPWRITE_FUNCTION_IMAGE_COMPRESS=homiva-image-compress

# --- Paystack (payments) ---
# Public key is safe to expose to the browser (pk_test_... or pk_live_...).
VITE_PAYSTACK_PUBLIC_KEY=

# --- Server (provisioning script + seed) - NEVER expose to the browser ---
# Create an API key in the Appwrite console with scopes:
#   databases.read/write, tables.read/write, collections.read/write,
#   documents.read/write, buckets.read/write, files.read/write,
#   users.read/write, teams.read/write, functions.read/write
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=6a56af86002ae69ae1fc
APPWRITE_API_KEY=

# Admin emails to bootstrap into the `admins` team (comma-separated).
# Each account must already exist (register in the app first), then re-run setup.
# ADMIN_EMAILS is also accepted and merged with ADMIN_EMAIL.
ADMIN_EMAIL=
ADMIN_EMAILS=
